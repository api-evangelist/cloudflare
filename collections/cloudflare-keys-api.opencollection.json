                "description": "The unique identifier of the KV namespace."
              },
              {
                "name": "cursor",
                "value": "example_value",
                "type": "query",
                "description": "Cursor for pagination."
              },
              {
                "name": "limit",
                "value": "10",
                "type": "query",
                "description": "Maximum number of keys to return."
              },
              {
                "name": "prefix",
