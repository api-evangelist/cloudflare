{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cloudflare / Accounts Routes API",
    "version": "4.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Routes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Cloudflare List Worker Routes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloudflare.com/client/v4/zones/:zone_id/workers/routes",
            "params": [
              {
                "name": "zone_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the zone."
              }
            ]
          },
          "docs": "Retrieve all routes mapping URL patterns to Worker scripts for a zone."
        },
        {
          "info": {
            "name": "Cloudflare Create Worker Route",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cloudflare.com/client/v4/zones/:zone_id/workers/routes",
            "params": [
              {
                "name": "zone_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the zone."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Map a URL pattern to a Worker script within the zone."
        },
        {
          "info": {
            "name": "Cloudflare Get Worker Route",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloudflare.com/client/v4/zones/:zone_id/workers/routes/:route_id",
            "params": [
              {
                "name": "zone_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the zone."
              },
              {
                "name": "route_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the route."
              }
            ]
          },
          "docs": "Retrieve details of a specific Worker route."
        },
        {
          "info": {
            "name": "Cloudflare Update Worker Route",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.cloudflare.com/client/v4/zones/:zone_id/workers/routes/:route_id",
            "params": [
              {
                "name": "zone_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the zone."
              },
              {
                "name": "route_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the route."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update the pattern or script assignment for a Worker route."
        },
        {
          "info": {
            "name": "Cloudflare Delete Worker Route",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.cloudflare.com/client/v4/zones/:zone_id/workers/routes/:route_id",
            "params": [
              {
                "name": "zone_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the zone."
              },
              {
                "name": "route_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the route."
              }
            ]
          },
          "docs": "Remove a Worker route from the zone."
        }
      ]
    }
  ],
  "bundled": true
}