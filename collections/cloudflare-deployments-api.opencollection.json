        {
          "info": {
            "name": "Cloudflare List Deployments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/pages/projects/:project_name/deployments",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the Cloudflare account."
              },
              {
                "name": "project_name",
                "value": "",
                "type": "path",
                "description": "The name of the Pages project."
              }
            ]
          },
          "docs": "Returns a list of all deployments for a Pages project."
        },
