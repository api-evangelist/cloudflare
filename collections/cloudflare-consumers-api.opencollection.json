        {
          "info": {
            "name": "Cloudflare List Queue Consumers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/queues/:queue_id/consumers",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the Cloudflare account."
              },
              {
                "name": "queue_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the queue."
              }
            ]
          },
          "docs": "Returns the consumers configured for a queue."
        },
        {
          "info": {
            "name": "Cloudflare Create Queue Consumer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/queues/:queue_id/consumers",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the Cloudflare account."
              },
              {
                "name": "queue_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the queue."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a new consumer to a queue to process messages."
        },
