{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cloudflare / Accounts Datasets API",
    "version": "4.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Datasets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Cloudflare List Dataset Fields",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloudflare.com/client/v4/zones/:zone_id/logpush/datasets/:dataset_id/fields",
            "params": [
              {
                "name": "zone_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the zone."
              },
              {
                "name": "dataset_id",
                "value": "500123",
                "type": "path",
                "description": "The dataset identifier such as http_requests, firewall_events, dns_logs, or spectrum_events."
              }
            ]
          },
          "docs": "Returns the available fields for a specific log dataset."
        }
      ]
    }
  ],
  "bundled": true
}