              {
                "name": "zone_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the zone."
              },
              {
                "name": "dns_record_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the DNS record."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Completely replace a DNS record with the provided data. All fields must be provided."
