            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/queues/:queue_id/messages/batch",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the Cloudflare account."
              },
              {
                "name": "queue_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the queue."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
