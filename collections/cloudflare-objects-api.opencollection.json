{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cloudflare / Accounts Objects API",
    "version": "4.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Objects",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Cloudflare List Durable Objects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/workers/durable_objects/namespaces/:namespace_id/objects",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the Cloudflare account."
              },
              {
                "name": "namespace_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the Durable Object namespace."
              },
              {
                "name": "cursor",
                "value": "example_value",
                "type": "query",
                "description": "Cursor for pagination."
              },
              {
                "name": "limit",
                "value": "10",
                "type": "query",
                "description": "Maximum number of objects to return."
              }
            ]
          },
          "docs": "Returns a list of Durable Objects within a namespace with cursor-based pagination."
        },
        {
          "info": {
            "name": "Cloudflare List Objects in Bucket",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/r2/buckets/:bucket_name/objects",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the Cloudflare account."
              },
              {
                "name": "bucket_name",
                "value": "",
                "type": "path",
                "description": "The name of the R2 bucket."
              },
              {
                "name": "prefix",
                "value": "example_value",
                "type": "query",
                "description": "Filter objects by key prefix."
              },
              {
                "name": "delimiter",
                "value": "example_value",
                "type": "query",
                "description": "Delimiter for grouping object keys."
              },
              {
                "name": "cursor",
                "value": "example_value",
                "type": "query",
                "description": "Cursor for pagination."
              },
              {
                "name": "per_page",
                "value": "10",
                "type": "query",
                "description": "Number of objects per page."
              }
            ]
          },
          "docs": "List objects stored in an R2 bucket with optional prefix filtering and pagination."
        }
      ]
    }
  ],
  "bundled": true
}