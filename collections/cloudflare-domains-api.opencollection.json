{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cloudflare / Accounts Domains API",
    "version": "4.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Domains",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Cloudflare List Worker Domains",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/workers/domains",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the Cloudflare account."
              }
            ]
          },
          "docs": "Retrieve all custom domains attached to Worker scripts."
        },
        {
          "info": {
            "name": "Cloudflare Attach Custom Domain",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/workers/domains",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the Cloudflare account."
              }
            ]
          },
          "docs": "Attach a custom domain to a Worker script."
        }
      ]
    }
  ],
  "bundled": true
}